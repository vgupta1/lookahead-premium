# Scopus exports: Elsevier's terms restrict redistributing downloaded records,
# and the abstracts are publisher copyright. See data/audit_journal/README.md.
data/audit_journal/scopus_export_*.csv
data/audit_journal/venue_sweep_2026-*.csv

# Hand-review sheets: these quote the abstracts of the records under review
# verbatim (publisher copyright, same grounds as the Scopus exports above).
