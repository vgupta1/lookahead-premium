__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
.venv/
venv/
_to_delete/

# Generated artifacts.  outputs/ is rebuilt by `make all`; the two figures and
# three tables the paper includes are tracked so a reader can see them without
# running anything -- see the note in README.md.
outputs/*.log
__pycache__/
*.pyc

# Scopus downloads of any kind: Elsevier's terms restrict redistributing records,
# and the abstracts are publisher copyright. See data/audit_journal/README.md.
data/audit_journal/**/scopus_*.csv
data/audit_journal/**/*_with_abstracts_*.csv

# Hand-review sheets: these quote the abstracts of the records under review
# verbatim (publisher copyright, same grounds as the Scopus exports above).
# One pattern, matched on the name shape, so a sheet added later is caught
# without anyone having to remember to extend this list.
# The rulings the sheets produced ARE committed -- the reasons, not the
# abstracts: venue_papers_vg_rulings_<DATE>.csv, survey_refs_vg_rulings_<DATE>.csv
# and venue_human_audit_vg_verdicts_<DATE>.csv.
data/audit_journal/**/*_sheet_*.md

# Resume cache for the survey screen: raw per-call model votes. The committed labels
# already carry every record's three votes (buckets_all) and the majority reason, so this
# is plumbing, not evidence. Stays on disk locally.
data/audit_journal/**/_cache/
